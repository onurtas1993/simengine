{
  "framework": {
    "fps": 60
  },

  "simulations": [
    {
      "name": "<simulation-name>",
      "endpoint": "127.0.0.1:7001",
      "plugin": "<plugin-file>",

      "inputs": [
        {
          "name": "<input-name>",
          "type": "<data-type>"
        }
      ],

      "outputs": [
        {
          "name": "<output-name>",
          "type": "<data-type>"
        }
      ]
    }
  ],

  "links": [
    {
